    "exceljs": "^4.4.0",
    "qs": "^6.11.0"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.7",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.7"
  }
}
