{
  "name": "crm-data-extractor",
  "version": "1.0.0",
  "description": "CRM Data Extractor — Download your CRM data as a formatted Excel report",
  "main": "index.js",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
